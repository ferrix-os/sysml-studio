<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SysmlStudio.App.ViewModels"
             xmlns:views="clr-namespace:SysmlStudio.App.Views"
             xmlns:nodify="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="SysmlStudio.App.Views.DiagramDocumentView"
             x:DataType="vm:DiagramDocumentViewModel">

  <UserControl.Styles>
    <!-- Relations drawn UML's way, along the route MSAGL found around the
         boxes: a hollow triangle for specialization, a filled diamond at the
         owner for composition, a dashed line and open head for the trace
         relations, small circles where a connection meets a part. -->
    <Style Selector="Path.edge">
      <Setter Property="Stroke" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="Path.edge.dashed">
      <Setter Property="StrokeDashArray" Value="4,3" />
    </Style>
    <Style Selector="Path.hit">
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="10" />
    </Style>
    <Style Selector="Path.head">
      <Setter Property="Stroke" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeJoin" Value="Miter" />
      <Setter Property="Fill" Value="{DynamicResource EdgeBrush}" />
    </Style>
    <Style Selector="Path.head.hollow">
      <Setter Property="Fill" Value="{DynamicResource CanvasBrush}" />
    </Style>
    <Style Selector="Path.head.open">
      <Setter Property="Fill" Value="Transparent" />
    </Style>
    <Style Selector="Path.tail">
      <Setter Property="Fill" Value="{DynamicResource EdgeBrush}" />
    </Style>
    <Style Selector="Path.anchor">
      <Setter Property="Fill" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
    </Style>
    <!-- A compartment of a UML box: a line above it, then its entries. -->
    <Style Selector="Border.compartment">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,7,12,9" />
    </Style>
    <Style Selector="Path.shape-line">
      <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="StrokeThickness" Value="1.1" />
      <Setter Property="Fill" Value="{DynamicResource SurfaceRaisedBrush}" />
    </Style>
    <Style Selector="Path.ports">
      <Setter Property="Fill" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Stroke" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
    </Style>
  </UserControl.Styles>

  <Panel Background="{DynamicResource CanvasBrush}">
    <nodify:NodifyEditor x:Name="Editor"
                         ContextRequested="OnContextRequested"
                         ItemsSource="{Binding Nodes}"
                         Connections="{Binding Connections}"
                         Decorators="{Binding Frames}"
                         ViewportZoom="{Binding Zoom, Mode=TwoWay}"
                         GridCellSize="8"
                         ItemsDragCompletedCommand="{Binding DragCompletedCommand}"
                         views:FitToScreen.OnShow="True">
      <!-- The dotted grid, moving and scaling with the diagram. -->
      <nodify:NodifyEditor.Background>
        <DrawingBrush TileMode="Tile" Stretch="None" DestinationRect="0,0,20,20" SourceRect="0,0,20,20"
                      Transform="{Binding #Editor.ViewportTransform}">
          <DrawingBrush.Drawing>
            <DrawingGroup>
              <GeometryDrawing Brush="Transparent" Geometry="M0,0 H20 V20 H0 Z" />
              <GeometryDrawing Brush="{DynamicResource CanvasGridBrush}">
                <GeometryDrawing.Geometry>
                  <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
                </GeometryDrawing.Geometry>
              </GeometryDrawing>
            </DrawingGroup>
          </DrawingBrush.Drawing>
        </DrawingBrush>
      </nodify:NodifyEditor.Background>

      <nodify:NodifyEditor.ItemContainerTheme>
        <ControlTheme TargetType="nodify:ItemContainer"
                      BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
                      x:DataType="vm:DiagramNodeViewModel">
          <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
          <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          <Setter Property="IsDraggable" Value="{Binding IsDraggable}" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="HighlightBrush" Value="Transparent" />
          <Setter Property="SelectedBrush" Value="{DynamicResource NodeSelectedBrush}" />
          <Setter Property="SelectedBorderThickness" Value="1" />
          <Setter Property="ClipToBounds" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.ItemContainerTheme>

      <!-- The frame round a whole diagram. It only marks; clicks go through it. -->
      <nodify:NodifyEditor.DecoratorContainerTheme>
        <ControlTheme TargetType="nodify:DecoratorContainer"
                      BasedOn="{StaticResource {x:Type nodify:DecoratorContainer}}"
                      x:DataType="vm:DiagramFrameViewModel">
          <Setter Property="Location" Value="{Binding Location}" />
          <Setter Property="IsHitTestVisible" Value="False" />
        </ControlTheme>
      </nodify:NodifyEditor.DecoratorContainerTheme>
      <nodify:NodifyEditor.DecoratorTemplate>
        <DataTemplate x:DataType="vm:DiagramFrameViewModel">
          <Border Width="{Binding Width}" Height="{Binding Height}" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource TextFaintBrush}" BorderThickness="1">
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="0,0,8,0"
                    BorderBrush="{DynamicResource TextFaintBrush}" BorderThickness="0,0,1,1" Padding="10,4,14,4">
              <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
            </Border>
          </Border>
        </DataTemplate>
      </nodify:NodifyEditor.DecoratorTemplate>

      <nodify:NodifyEditor.ItemTemplate>
        <DataTemplate x:DataType="vm:DiagramNodeViewModel">
          <Panel>
            <!-- UML's shapes: what they share is one body; what tells them apart is drawn around it. -->
            <Panel Width="{Binding Width}" MinHeight="{Binding Height}" IsVisible="{Binding IsUml}">
              <Path Classes="shape-line" Data="{Binding DepthFaces}" IsVisible="{Binding IsDevice}" />
              <Border IsVisible="{Binding IsFolder}" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Width="{Binding TabWidth}" Height="17"
                      Background="{DynamicResource SurfaceRaisedBrush}"
                      BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1,1,1,0" />
              <Panel Margin="{Binding BodyMargin}">
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1">
                  <StackPanel Margin="{Binding PortBands}">
                    <StackPanel Margin="14,9,14,9" Spacing="1">
                      <TextBlock Text="{Binding Stereotype}" Classes="faint" FontSize="12" HorizontalAlignment="Center"
                                 IsVisible="{Binding HasStereotype}" />
                      <TextBlock Text="{Binding Title}" FontSize="15" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 TextDecorations="{Binding TitleDecorations}" FontStyle="{Binding TitleStyle}" />
                    </StackPanel>
                    <Border Classes="compartment" IsVisible="{Binding HasUmlFeatures}">
                      <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="mono muted" FontSize="12" LineHeight="19" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <Border Classes="compartment" IsVisible="{Binding HasOperations}">
                      <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding}" Classes="mono muted" FontSize="12" LineHeight="19" TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Border>
                <!-- A reference's dashed border, over the solid one in the box's own colour. -->
                <Rectangle IsVisible="{Binding IsReference}" Stroke="{DynamicResource SurfaceRaisedBrush}" StrokeThickness="1.4" />
                <Rectangle IsVisible="{Binding IsReference}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1" StrokeDashArray="4,3" />
              </Panel>
              <!-- UML's component icon -->
              <Path Classes="shape-line" IsVisible="{Binding IsComponent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="{Binding IconMargin}" Data="M3,0 H17 V14 H3 Z M0,3 H6 V6 H0 Z M0,8 H6 V11 H0 Z" />
              <!-- UML's artifact icon: a page with a folded corner -->
              <Path Classes="shape-line" IsVisible="{Binding IsArtifact}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="{Binding IconMargin}" Data="M0,0 H9 L13,4 V16 H0 Z M9,0 V4 H13" />
              <!-- Ports: on the border, with their names in the band inside it. -->
              <ItemsControl ItemsSource="{Binding Ports}" IsHitTestVisible="False" ClipToBounds="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Panel ClipToBounds="False" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiagramPortViewModel">
                    <Canvas>
                      <Path Classes="shape-line" Data="{Binding Glyph}" />
                      <Border Canvas.Left="{Binding SquareLeft}" Canvas.Top="{Binding SquareTop}" Width="10" Height="10"
                              Background="{DynamicResource SurfaceRaisedBrush}"
                              BorderBrush="{DynamicResource TextMutedBrush}" BorderThickness="1.2" />
                      <TextBlock Canvas.Left="{Binding LabelLeft}" Canvas.Top="{Binding LabelTop}" Width="{Binding LabelWidth}"
                                 Text="{Binding Name}" Classes="muted" FontSize="12" TextAlignment="Center" />
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
            <!-- start and done: UML's initial and final nodes -->
            <Panel Width="{Binding Width}" Height="{Binding Height}" IsVisible="{Binding IsPseudo}">
              <Ellipse Width="18" Height="18" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsStart}" />
              <Ellipse Width="24" Height="24" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5" IsVisible="{Binding IsDone}" />
              <Ellipse Width="12" Height="12" Fill="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsDone}" />
            </Panel>
            <!-- Every other UML shape is drawn from the marks the SVG export writes too. -->
            <views:MarkCanvas Width="{Binding Width}" Height="{Binding Height}" IsVisible="{Binding IsDrawn}" Marks="{Binding Marks}" />
            <Border Width="{Binding Width}" MinHeight="{Binding Height}" IsVisible="{Binding IsBox}"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="{Binding Corners}">
              <StackPanel>
                <StackPanel Margin="14,11,14,12" Spacing="3">
                  <TextBlock Text="{Binding KindCaption}" Classes="faint" FontSize="12" TextTrimming="CharacterEllipsis"
                             IsVisible="{Binding HasCaption}" />
                  <TextBlock Text="{Binding Title}" FontSize="16" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Documentation}" Classes="muted" FontSize="13.5" TextWrapping="Wrap"
                             LineHeight="20" MaxHeight="80" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                             IsVisible="{Binding HasDocumentation}" />
                </StackPanel>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="14,7,14,9" IsVisible="{Binding HasFeatures}">
                  <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" Classes="mono muted" FontSize="12" LineHeight="19"
                                   TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </Border>
          </Panel>
        </DataTemplate>
      </nodify:NodifyEditor.ItemTemplate>

      <nodify:NodifyEditor.ConnectionTemplate>
        <DataTemplate x:DataType="vm:DiagramConnectionViewModel">
          <Panel>
            <Path Classes="edge" Classes.dashed="{Binding IsDashed}" Data="{Binding Line}" IsHitTestVisible="False" />
            <Path Classes="hit" Data="{Binding Line}" ToolTip.Tip="{Binding Description}" ToolTip.ShowDelay="150" />
            <Path Classes="head" Classes.hollow="{Binding IsGeneralization}" Classes.open="{Binding IsOpenHead}"
                  Data="{Binding Head}" IsHitTestVisible="False" />
            <Path Classes="tail" Data="{Binding Tail}" IsHitTestVisible="False" />
            <Path Classes="anchor" Data="{Binding Anchor}" IsHitTestVisible="False" />
            <Path Classes="ports" Data="{Binding Ports}" IsHitTestVisible="False" />
            <!-- The label lives in the connection's own layer, so it scales
                 with the diagram and sits where MSAGL placed it. -->
            <Canvas IsVisible="{Binding ShowsLabel}" IsHitTestVisible="False">
              <Border Canvas.Left="{Binding LabelLocation.X}" Canvas.Top="{Binding LabelLocation.Y}"
                      Background="{DynamicResource CanvasBrush}" Padding="3,0">
                <TextBlock Text="{Binding Label}" Classes.faint="{Binding !SaysWhatHappens}" Classes.muted="{Binding SaysWhatHappens}" FontSize="12" />
              </Border>
            </Canvas>
          </Panel>
        </DataTemplate>
      </nodify:NodifyEditor.ConnectionTemplate>
    </nodify:NodifyEditor>

    <!-- The toolbar: pointer, what can be added or drawn here, auto-layout -->
    <Panel Margin="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CanvasInsets}">
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
            Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Padding="4" BoxShadow="0 2 10 0 #18000000">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="flat" Classes.active="{Binding IsPointer}" Padding="7,5"
                ToolTip.Tip="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Keys[cancel]}"
                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CancelToolCommand}">
          <ic:SymbolIcon Symbol="Cursor" FontSize="16" />
        </Button>
        <ItemsControl ItemsSource="{Binding Toolbox}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToolboxItem">
              <Button Classes="flat" Classes.active="{Binding IsActive}" Padding="10,5" Click="OnToolboxClick"
                      ToolTip.Tip="{Binding Tip}">
                <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Width="1" Margin="6,4" Background="{DynamicResource BorderBrush}" />
        <Button Classes="flat" Padding="10,5" Command="{Binding RelayoutCommand}"
                ToolTip.Tip="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Keys[autoLayout]}">
          <TextBlock Text="Auto-layout" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Zoom -->
    <Button Classes="link" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"
            Command="{Binding FitCommand}" ToolTip.Tip="{Binding $parent[Window].((vm:ShellViewModel)DataContext).Keys[fit]}">
      <TextBlock Text="{Binding ZoomText}" Classes="mono faint" FontSize="12" />
    </Button>
    </Panel>
  </Panel>
</UserControl>
